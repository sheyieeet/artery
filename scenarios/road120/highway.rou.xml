<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Define highway vehicle kinematics (max speed ~ 120 km/h) -->
    <vType id="car_highway" length="5.0" maxSpeed="35.0" accel="2.6" decel="4.5" sigma="0.5"/>

    <!-- Eastbound Flow -->
    <flow id="flow_east" type="car_highway" begin="0" end="3600" probability="0.6" departLane="random" departSpeed="max">
        <route edges="A0B0"/>
    </flow>

    <!-- Westbound Flow -->
    <flow id="flow_west" type="car_highway" begin="0" end="3600" probability="0.6" departLane="random" departSpeed="max">
        <route edges="B0A0"/>
    </flow>
</routes>
